# ============================================================
# Job Hunter — variáveis de ambiente
# Copie este arquivo para .env e preencha as chaves.
# Fontes sem chave (Remotive, RemoteOK, Arbeitnow, The Muse)
# funcionam automaticamente.
# ============================================================

# ── GOOGLE JOBS via SerpAPI (MAIS IMPORTANTE) ─────────────────
# Agrega Gupy, LinkedIn, Indeed, Vagas.com, InfoJobs, Catho e outros.
# Gratuito: 100 buscas/mês
# Obtenha em: https://serpapi.com → Sign Up → API Key
SERPAPI_KEY=

# ── JSEARCH via RapidAPI ─────────────────────────────────────
# Agrega LinkedIn, Indeed, Glassdoor. Gratuito: 200 req/mês.
# Obtenha em: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# → Subscribe → Basic (Free) → Copy "X-RapidAPI-Key"
JSEARCH_API_KEY=

# ── ADZUNA ────────────────────────────────────────────────────
# Tem endpoint Brasil. Gratuito: 250 req/dia.
# Obtenha em: https://developer.adzuna.com → Sign Up → My Apps
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Configurações do servidor ─────────────────────────────────
PORT=8000
